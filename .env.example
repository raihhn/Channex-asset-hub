# Local development/test only. Never use a production database for tests.
ASSETHUB_DATABASE_URL=postgresql://localhost:54329/assethub_dev
NEXT_PUBLIC_ASSETHUB_BOOKING_ENABLED=true

# Local vendor master; server-only flag, independent of durable booking.
ASSETHUB_VENDOR_ENABLED=true

# Server-only local imported-media signing secret (generate a random value locally).
ASSETHUB_MEDIA_SIGNING_KEY=
